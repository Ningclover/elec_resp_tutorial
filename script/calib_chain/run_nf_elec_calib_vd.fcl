# PDVD electronics-response CALIBRATION noise-filter job (validation).
#
# Runs ONLY the WireCell noise-filter stage with the per-channel
# electronics-response correction enabled (perChannelShaper), reading the
# decoded RawDigits (tpcrawdecoder:daq) from a reco_stage1 art-ROOT file and
# writing the response-equalized RawDigits as product "wclsdatavdfilter:raw".
#
# Driven by run_elec_calib.sh.  The corrected RawDigits are later dumped to a
# magnify TH2 (vd_convert_artroot_raw.C) and re-fit with the ideal
# cold-electronics response (wf_fitter_ideal.C) to validate the per-channel
# equalization.

#include "services_dune.fcl"
#include "wirecell_dune.fcl"

process_name: pdvdeleccalib

services: {
  TFileService:           { fileName: "%ifb_eleccalib_hist.root" }
  TimeTracker:            {}
  MemoryTracker:          {}
  RandomNumberGenerator:  {}
  message:                @local::dune_message_services_prod
  @table::protodunevd_services
}

source: {
  module_type: RootInput
  maxEvents:   -1
}

physics: {
  producers: {
    # Per-channel electronics-response calibration NF.  Built from the
    # standard protodunevd_nf block, only the WCT config is swapped for the
    # calibration variant that adds the perChannelShaper.
    wclsdatavdfilter: @local::protodunevd_nf
  }
  reco:    [ wclsdatavdfilter ]
  stream1: [ out1 ]
  trigger_paths: [ reco ]
  end_paths:     [ stream1 ]
}

# Point the NF at the calibration WCT config (adds perChannelShaper + chresp).
physics.producers.wclsdatavdfilter.wcls_main.configs: [ "pgrapher/experiment/protodunevd/wcls_nf_elec_calib.jsonnet" ]
physics.producers.wclsdatavdfilter.wcls_main.params.raw_input_label: "tpcrawdecoder:daq"
# Only the corrected (nf) digits are saved.  The uncorrected before-image comes
# from "tpcrawdecoder:daq" directly (the inline origsaver writes 0 RawDigits in
# this WCLS version, so it was dropped from the graph).
physics.producers.wclsdatavdfilter.wcls_main.outputers: [ "wclsFrameSaver:nfsaver" ]
physics.producers.wclsdatavdfilter.wcls_main.loglevels: @erase
physics.producers.wclsdatavdfilter.wcls_main.logsinks: @erase

# PDVD clocking/detprop settings (match Karla's stage1 keepup).
services.DetectorClocksService.DefaultTrigTime:   2500
services.DetectorClocksService.TriggerOffsetTPC:  2500
services.DetectorClocksService.ClockSpeedTPC:     2
services.DetectorPropertiesService.NumberTimeSamples: 10000
services.DetectorPropertiesService.ReadOutWindowSize: 10000

outputs: {
  out1: {
    module_type: RootOutput
    fileName:    "%ifb_eleccalib.root"
    dataTier:    "reconstructed"
    outputCommands: [ "keep *" ]
  }
}
